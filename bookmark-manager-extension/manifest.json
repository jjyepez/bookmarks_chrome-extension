{
  "manifest_version": 3,
  "name": "Bookmark Manager",
  "version": "1.23.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "contextMenus",
    "sidePanel"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
